let Core = import "/libraries/nickel-tf/contracts.ncl" in
Core.ResourceFor "proxmox" "proxmox" ({
"base_dn" | Core.Value (Core.NonNull (String)),
"bind_dn" | Core.Value (Core.Nullable (String)) | optional,
"bind_password" | Core.Value (Core.Nullable (String)) | optional,
"ca_path" | Core.Value (Core.Nullable (String)) | optional,
"case_sensitive" | Core.Value (Core.Nullable (Bool)) | optional,
"cert_key_path" | Core.Value (Core.Nullable (String)) | optional,
"cert_path" | Core.Value (Core.Nullable (String)) | optional,
"comment" | Core.Value (Core.Nullable (String)) | optional,
"default" | Core.Value (Core.Nullable (Bool)) | optional,
"filter" | Core.Value (Core.Nullable (String)) | optional,
"group_classes" | Core.Value (Core.Nullable (String)) | optional,
"group_dn" | Core.Value (Core.Nullable (String)) | optional,
"group_filter" | Core.Value (Core.Nullable (String)) | optional,
"group_name_attr" | Core.Value (Core.Nullable (String)) | optional,
"mode" | Core.Value (Core.Nullable (String)) | optional,
"port" | Core.Value (Core.Nullable (Number)) | optional,
"realm" | Core.Value (Core.NonNull (String)),
"secure" | Core.Value (Core.Nullable (Bool)) | optional,
"server1" | Core.Value (Core.NonNull (String)),
"server2" | Core.Value (Core.Nullable (String)) | optional,
"ssl_version" | Core.Value (Core.Nullable (String)) | optional,
"sync_attributes" | Core.Value (Core.Nullable (String)) | optional,
"sync_defaults_options" | Core.Value (Core.Nullable (String)) | optional,
"user_attr" | Core.Value (Core.Nullable (String)) | optional,
"user_classes" | Core.Value (Core.Nullable (String)) | optional,
"verify" | Core.Value (Core.Nullable (Bool)) | optional,
})
