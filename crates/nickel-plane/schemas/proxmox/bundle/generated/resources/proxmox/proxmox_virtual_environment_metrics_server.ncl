"disable" | Core.Value (Core.Nullable (Bool)) | optional,
"graphite_path" | Core.Value (Core.Nullable (String)) | optional,
"graphite_proto" | Core.Value (Core.Nullable (String)) | optional,
"influx_api_path_prefix" | Core.Value (Core.Nullable (String)) | optional,
"influx_bucket" | Core.Value (Core.Nullable (String)) | optional,
"influx_db_proto" | Core.Value (Core.Nullable (String)) | optional,
"influx_max_body_size" | Core.Value (Core.Nullable (Number)) | optional,
"influx_organization" | Core.Value (Core.Nullable (String)) | optional,
"influx_token" | Core.Value (Core.Nullable (String)) | optional,
"influx_token_wo" | Core.Value (Core.Nullable (String)) | optional,
"influx_token_wo_version" | Core.Value (Core.Nullable (Number)) | optional,
"influx_verify" | Core.Value (Core.Nullable (Bool)) | optional,
"mtu" | Core.Value (Core.Nullable (Number)) | optional,
"name" | Core.Value (Core.NonNull (String)),
"opentelemetry_compression" | Core.Value (Core.Nullable (String)) | optional,
"opentelemetry_headers" | Core.Value (Core.Nullable (String)) | optional,
"opentelemetry_max_body_size" | Core.Value (Core.Nullable (Number)) | optional,
"opentelemetry_path" | Core.Value (Core.Nullable (String)) | optional,
"opentelemetry_proto" | Core.Value (Core.Nullable (String)) | optional,
"opentelemetry_resource_attributes" | Core.Value (Core.Nullable (String)) | optional,
"opentelemetry_timeout" | Core.Value (Core.Nullable (Number)) | optional,
"opentelemetry_verify_ssl" | Core.Value (Core.Nullable (Bool)) | optional,
"port" | Core.Value (Core.NonNull (Number)),
"server" | Core.Value (Core.NonNull (String)),
"timeout" | Core.Value (Core.Nullable (Number)) | optional,
"type" | Core.Value (Core.NonNull (String)),
})
