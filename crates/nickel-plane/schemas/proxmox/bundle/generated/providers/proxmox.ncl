let Core = import "/libraries/nickel-tf/contracts.ncl" in
{
"api_headers" | Core.Value (Core.Nullable ({ _ | Core.Value (Core.Nullable (String)) })) | optional,
"api_token" | Core.Value (Core.Nullable (String)) | optional,
"auth_ticket" | Core.Value (Core.Nullable (String)) | optional,
"csrf_prevention_token" | Core.Value (Core.Nullable (String)) | optional,
"endpoint" | Core.Value (Core.Nullable (String)) | optional,
"insecure" | Core.Value (Core.Nullable (Bool)) | optional,
"min_tls" | Core.Value (Core.Nullable (String)) | optional,
"otp" | Core.Value (Core.Nullable (String)) | optional,
"password" | Core.Value (Core.Nullable (String)) | optional,
"random_vm_id_end" | Core.Value (Core.Nullable (Number)) | optional,
"random_vm_id_start" | Core.Value (Core.Nullable (Number)) | optional,
"random_vm_ids" | Core.Value (Core.Nullable (Bool)) | optional,
"tmp_dir" | Core.Value (Core.Nullable (String)) | optional,
"username" | Core.Value (Core.Nullable (String)) | optional,
"ssh" | Core.Bounds 0 1 (Array ({
"agent" | Core.Value (Core.Nullable (Bool)) | optional,
"agent_forwarding" | Core.Value (Core.Nullable (Bool)) | optional,
"agent_socket" | Core.Value (Core.Nullable (String)) | optional,
"node_address_source" | Core.Value (Core.Nullable (String)) | optional,
"password" | Core.Value (Core.Nullable (String)) | optional,
"private_key" | Core.Value (Core.Nullable (String)) | optional,
"root_ticket" | Core.Value (Core.Nullable (Bool)) | optional,
"socks5_password" | Core.Value (Core.Nullable (String)) | optional,
"socks5_server" | Core.Value (Core.Nullable (String)) | optional,
"socks5_username" | Core.Value (Core.Nullable (String)) | optional,
"username" | Core.Value (Core.Nullable (String)) | optional,
"node" | Core.Bounds 0 0 (Array ({
"address" | Core.Value (Core.NonNull (String)),
"name" | Core.Value (Core.NonNull (String)),
"port" | Core.Value (Core.Nullable (Number)) | optional,
})) | optional,
})) | optional,
}
